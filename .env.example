# Local development only. Replace every value with a managed secret in production.
APP_ENV=development
APP_NAME=SiraPilot AI
POSTGRES_DB=sirapilot
POSTGRES_USER=sira_dev
POSTGRES_PASSWORD=local-dev-only-change-before-deploy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sira_dev:local-dev-only-change-before-deploy@localhost:5432/sirapilot
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=local-development-secret-change-before-deploy-9f31
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
LOG_LEVEL=INFO
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_EMAIL_VERIFICATION_HOURS=24
AUTH_PASSWORD_RESET_MINUTES=60
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173
MAX_CV_UPLOAD_BYTES=10485760
PRIVATE_STORAGE_PATH=./private_uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sirapilot.local
